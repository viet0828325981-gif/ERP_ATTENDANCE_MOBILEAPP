@namespace ERP_PAYROLLMOBILE.Components.Shared
@inject NavigationManager Navigation

<div class="bottom-nav manager-bottom-nav">
    @foreach (var item in Items)
    {
        <div class="nav-item @(item.Label == ActiveTab ? "active" : string.Empty)"
             @onclick="() => Navigate(item.Route)">
            @item.Label
        </div>
    }
</div>

@code {
    [Parameter] public string ActiveTab { get; set; } = "QL công";

    private static readonly (string Label, string Route)[] Items =
    {
        ("QL công", "/manager/daily"),
        ("QL yêu cầu", "/manager/requests"),
        ("QL ca", "/manager/shift")
    };

    private void Navigate(string route)
    {
        if (string.Equals(Navigation.Uri, Navigation.ToAbsoluteUri(route).ToString(), StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        Navigation.NavigateTo(route);
    }
}
