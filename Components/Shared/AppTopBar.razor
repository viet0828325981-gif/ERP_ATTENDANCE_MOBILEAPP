@namespace ERP_PAYROLLMOBILE.Components.Shared

<div class="topbar app-topbar">
    <div class="brand">ERP_EMPLOYEE</div>
    <div class="right">
        <div class="bell-wrap">
            <svg class="bell" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.7 21a2 2 0 01-3.4 0" />
            </svg>
            @if (NotificationCount > 0)
            {
                <span class="badge">@NotificationCount</span>
            }
        </div>
        <div class="logout" @onclick="OnLogout">Đăng xuất</div>
    </div>
</div>
