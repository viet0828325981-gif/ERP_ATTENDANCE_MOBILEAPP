@using System.Globalization
@using ERP_PAYROLLMOBILE.Models.EmployeeRequest
@using ERP_PAYROLLMOBILE.Models.ManagerRole.ManagerShift
@using ERP_PAYROLLMOBILE.Services.Features.Shift
@inject IShiftFeatureService ShiftFeatureService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    .manager-shift-registration-dialog .mud-picker {
        max-width: 360px;
        width: 360px;
    }
</style>

<MudDialog Class="manager-shift-registration-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">Đăng ký ca cho nhân viên</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                Đăng ký ca từ màn quản lý sẽ có hiệu lực ngay, không cần duyệt.
            </MudAlert>

            @if (_loadingShifts)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                    Đang tải danh sách ca làm việc...
                </MudAlert>
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            }
            else if (!string.IsNullOrWhiteSpace(_loadErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
                    @_loadErrorMessage
                </MudAlert>
            }

            <MudSelect T="int"
                       @bind-Value="_registrationMode"
                       Label="Hình thức đăng ký"
                       Margin="Margin.Dense"
                       Class="mb-4"
                       Style="max-width:320px;">
                <MudSelectItem T="int" Value="1">Đăng ký từng ngày trong tuần</MudSelectItem>
                <MudSelectItem T="int" Value="2">Đăng ký theo tháng</MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="_searchText"
                          Label="Tìm nhân viên"
                          Placeholder="Mã NV hoặc tên"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Class="mb-2" />

            <div class="d-flex gap-2 mb-3 flex-wrap">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SelectAllFiltered">Chọn tất cả đang lọc</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearSelection">Bỏ chọn</MudButton>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@_selectedEmployeeIds.Count nhân viên</MudChip>
            </div>

            <MudTable Items="@FilteredEmployees" Dense="true" Hover="true" Height="260px" FixedHeader="true" Class="mb-4">
                <HeaderContent>
                    <MudTh Style="width:56px;"></MudTh>
                    <MudTh>Mã NV</MudTh>
                    <MudTh>Họ tên</MudTh>
                    <MudTh>Phòng ban</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudCheckBox T="bool"
                                     Value="@IsSelected(context.EmployeeId)"
                                     ValueChanged="@(checkedValue => ToggleEmployee(context.EmployeeId, checkedValue))" />
                    </MudTd>
                    <MudTd>@context.EmployeeId</MudTd>
                    <MudTd>@context.FullName</MudTd>
                    <MudTd>@context.DepartmentName</MudTd>
                </RowTemplate>
            </MudTable>

            <div class="d-flex gap-4 align-center flex-wrap">
                @if (IsWeeklyMode)
                {
                    <MudDatePicker @bind-Date="_weekDate"
                                   Label="Tuần đăng ký"
                                   Required="true"
                                   RequiredError="Vui lòng chọn tuần đăng ký."
                                   Margin="Margin.Dense"
                                   DateFormat="dd/MM/yyyy"
                                   HelperText="Chỉ được chọn ngày Thứ 2 của tuần cần đăng ký."
                                   PickerVariant="PickerVariant.Dialog"
                                   Orientation="Orientation.Landscape"
                                   IsDateDisabledFunc="IsWeeklyDateDisabled"
                                   Style="min-width:360px;" />
                }
                else
                {
                    <MudDatePicker @bind-Date="_monthDate"
                                   Label="Tháng đăng ký"
                                   Required="true"
                                   RequiredError="Vui lòng chọn tháng đăng ký."
                                   Margin="Margin.Dense"
                                   DateFormat="MM/yyyy"
                                   HelperText="Chọn tháng cần áp dụng."
                                   PickerVariant="PickerVariant.Dialog"
                                   Orientation="Orientation.Landscape"
                                   OpenTo="OpenTo.Month"
                                   IsDateDisabledFunc="IsMonthDateDisabled"
                                   Style="min-width:360px;" />
                }
            </div>

            @if (IsWeeklyMode)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Chọn ca cho từng ngày</MudText>

                <div class="d-flex gap-4 align-center flex-wrap">
                    <MudSelect T="string" @bind-Value="_monShiftCode" Label="Thứ 2" Clearable="true" Margin="Margin.Dense" Style="width:130px;">
                        @foreach (var shift in _shifts)
                        {
                            <MudSelectItem T="string" Value="@shift.ShiftCode">@GetShiftDisplayText(shift)</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@SplitShiftCode">CG - Ca gãy</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_tueShiftCode" Label="Thứ 3" Clearable="true" Margin="Margin.Dense" Style="width:130px;">
                        @foreach (var shift in _shifts)
                        {
                            <MudSelectItem T="string" Value="@shift.ShiftCode">@GetShiftDisplayText(shift)</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@SplitShiftCode">CG - Ca gãy</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_wedShiftCode" Label="Thứ 4" Clearable="true" Margin="Margin.Dense" Style="width:130px;">
                        @foreach (var shift in _shifts)
                        {
                            <MudSelectItem T="string" Value="@shift.ShiftCode">@GetShiftDisplayText(shift)</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@SplitShiftCode">CG - Ca gãy</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_thuShiftCode" Label="Thứ 5" Clearable="true" Margin="Margin.Dense" Style="width:130px;">
                        @foreach (var shift in _shifts)
                        {
                            <MudSelectItem T="string" Value="@shift.ShiftCode">@GetShiftDisplayText(shift)</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@SplitShiftCode">CG - Ca gãy</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_friShiftCode" Label="Thứ 6" Clearable="true" Margin="Margin.Dense" Style="width:130px;">
                        @foreach (var shift in _shifts)
                        {
                            <MudSelectItem T="string" Value="@shift.ShiftCode">@GetShiftDisplayText(shift)</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@SplitShiftCode">CG - Ca gãy</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_satShiftCode" Label="Thứ 7" Clearable="true" Margin="Margin.Dense" Style="width:130px;">
                        @foreach (var shift in _shifts)
                        {
                            <MudSelectItem T="string" Value="@shift.ShiftCode">@GetShiftDisplayText(shift)</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@SplitShiftCode">CG - Ca gãy</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_sunShiftCode" Label="Chủ nhật" Clearable="true" Margin="Margin.Dense" Style="width:130px;">
                        @foreach (var shift in _shifts)
                        {
                            <MudSelectItem T="string" Value="@shift.ShiftCode">@GetShiftDisplayText(shift)</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@SplitShiftCode">CG - Ca gãy</MudSelectItem>
                    </MudSelect>
                </div>
            }
            else
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Chọn ca đăng ký cho cả tháng</MudText>

                <MudSelect T="string"
                           @bind-Value="_monthlyShiftCode"
                           Label="Ca đăng ký"
                           Clearable="true"
                           Margin="Margin.Dense"
                           Style="max-width:320px;">
                    @foreach (var shift in _shifts)
                    {
                        <MudSelectItem T="string" Value="@shift.ShiftCode">@GetShiftDisplayText(shift)</MudSelectItem>
                    }
                    <MudSelectItem T="string" Value="@SplitShiftCode">CG - Ca gãy</MudSelectItem>
                </MudSelect>

                <MudCheckBox T="bool"
                             @bind-Value="_includeSundayForMonth"
                             Label="Đăng ký cả ngày chủ nhật trong tháng"
                             Class="mt-2" />
            }

            @if (IsSplitShiftSelected)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4 mb-2">
                    Ca gãy: @FormatSplitShiftTimes()
                </MudAlert>
                <div class="d-flex gap-4 align-center flex-wrap">
                    <MudTextField T="string"
                                  @bind-Value="_morningEndText"
                                  Label="Giờ kết thúc ca sáng"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Time"
                                  Style="max-width:220px;" />
                    <MudTextField T="string"
                                  @bind-Value="_eveningStartText"
                                  Label="Giờ bắt đầu ca tối"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Time"
                                  Style="max-width:220px;" />
                </div>
            }

            <MudTextField @bind-Value="_registrationNote"
                          Label="Ghi chú"
                          Lines="3"
                          Margin="Margin.Dense"
                          Class="mt-4" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())" Disabled="_submitting">Hủy</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   OnClick="SubmitAsync"
                   Disabled="_submitting || _loadingShifts || _shifts.Count == 0 || !string.IsNullOrWhiteSpace(_loadErrorMessage)">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Lưu đăng ký
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public Guid? DepartmentId { get; set; }
    [Parameter] public string CreatedBy { get; set; } = string.Empty;
    [Parameter] public List<ManagerShiftEmployeeOption> Employees { get; set; } = new();
    [Parameter] public List<string> SelectedEmployeeIds { get; set; } = new();

    private const int WeeklyMode = 1;
    private const int MonthlyMode = 2;
    private const string SplitShiftCode = "CG";

    private MudForm _form = default!;
    private int _registrationMode = WeeklyMode;
    private DateTime? _weekDate;
    private DateTime? _monthDate;
    private string? _monthlyShiftCode;
    private string? _monShiftCode;
    private string? _tueShiftCode;
    private string? _wedShiftCode;
    private string? _thuShiftCode;
    private string? _friShiftCode;
    private string? _satShiftCode;
    private string? _sunShiftCode;
    private bool _includeSundayForMonth;
    private string? _morningEndText;
    private string? _eveningStartText;
    private string? _registrationNote;
    private string? _searchText;
    private bool _submitting;
    private bool _loadingShifts;
    private string? _loadErrorMessage;
    private bool _selectionInitialized;
    private Guid? _loadedDepartmentId;
    private List<ShiftModel> _shifts = new();
    private HashSet<string> _selectedEmployeeIds = new(StringComparer.OrdinalIgnoreCase);

    private bool IsWeeklyMode => _registrationMode == WeeklyMode;

    private IEnumerable<ManagerShiftEmployeeOption> FilteredEmployees
    {
        get
        {
            var items = Employees.AsEnumerable();

            if (DepartmentId.HasValue)
            {
                items = items.Where(x => x.DepartmentId == DepartmentId);
            }

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                items = items.Where(x => x.EmployeeId.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                    || x.FullName.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
            }

            return items.OrderBy(x => x.EmployeeId).Take(200);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _weekDate ??= GetWeekStartMonday(DateOnly.FromDateTime(DateTime.Today)).ToDateTime(TimeOnly.MinValue);
        _monthDate ??= new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        if (!_selectionInitialized)
        {
            _selectedEmployeeIds = SelectedEmployeeIds.Count > 0
                ? SelectedEmployeeIds.Where(x => !string.IsNullOrWhiteSpace(x)).ToHashSet(StringComparer.OrdinalIgnoreCase)
                : Employees.Where(x => !DepartmentId.HasValue || x.DepartmentId == DepartmentId)
                    .Select(x => x.EmployeeId)
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
            _selectionInitialized = true;
        }

        if (_loadedDepartmentId == DepartmentId && (_shifts.Count > 0 || _loadingShifts || !string.IsNullOrWhiteSpace(_loadErrorMessage)))
        {
            return;
        }

        _loadedDepartmentId = DepartmentId;
        _shifts.Clear();
        _loadErrorMessage = null;

        if (!DepartmentId.HasValue)
        {
            _loadErrorMessage = "Vui lòng chọn phòng ban trước khi đăng ký ca.";
            return;
        }

        _loadingShifts = true;
        try
        {
            _shifts = (await ShiftFeatureService.GetShiftsAsync(CompanyId, DepartmentId.Value))
                .Where(x => x.IsActive)
                .Where(x => x.ShiftCode is "CC" or "CS" or "CT" or "CSF" or "CTF" or "BC")
                .OrderBy(x => GetShiftOrder(x.ShiftCode))
                .ToList();

            if (_shifts.Count == 0)
            {
                _loadErrorMessage = "Không tải được danh sách ca làm việc đang hoạt động.";
            }
        }
        catch (Exception ex)
        {
            _loadErrorMessage = $"Không tải được danh sách ca làm việc: {ex.Message}";
            Snackbar.Add(_loadErrorMessage, Severity.Error);
        }
        finally
        {
            _loadingShifts = false;
        }
    }

    private bool IsSelected(string employeeId) => _selectedEmployeeIds.Contains(employeeId);

    private void ToggleEmployee(string employeeId, bool selected)
    {
        if (selected)
        {
            _selectedEmployeeIds.Add(employeeId);
        }
        else
        {
            _selectedEmployeeIds.Remove(employeeId);
        }
    }

    private void SelectAllFiltered()
    {
        foreach (var employee in FilteredEmployees)
        {
            _selectedEmployeeIds.Add(employee.EmployeeId);
        }
    }

    private void ClearSelection() => _selectedEmployeeIds.Clear();

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        if (_selectedEmployeeIds.Count == 0)
        {
            Snackbar.Add("Phải chọn ít nhất một nhân viên.", Severity.Warning);
            return;
        }

        if (_loadingShifts)
        {
            Snackbar.Add("Danh sách ca đang tải, vui lòng thử lại sau.", Severity.Info);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_loadErrorMessage) || _shifts.Count == 0)
        {
            Snackbar.Add(_loadErrorMessage ?? "Không có ca làm việc để đăng ký.", Severity.Error);
            return;
        }

        if (IsWeeklyMode && !HasAnyShift())
        {
            Snackbar.Add("Phải chọn ít nhất một ca.", Severity.Warning);
            return;
        }

        if (!IsWeeklyMode && string.IsNullOrWhiteSpace(_monthlyShiftCode))
        {
            Snackbar.Add("Phải chọn ca đăng ký cho cả tháng.", Severity.Warning);
            return;
        }

        var morningEnd = ParseTime(_morningEndText);
        var eveningStart = ParseTime(_eveningStartText);

        if (IsSplitShiftSelected && (!morningEnd.HasValue || !eveningStart.HasValue))
        {
            Snackbar.Add("Ca gãy phải nhập giờ kết thúc ca sáng và giờ bắt đầu ca tối.", Severity.Warning);
            return;
        }

        if (IsSplitShiftSelected && morningEnd >= eveningStart)
        {
            Snackbar.Add("Giờ kết thúc ca sáng phải nhỏ hơn giờ bắt đầu ca tối.", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var employeeIds = _selectedEmployeeIds.OrderBy(x => x).ToList();
            if (IsWeeklyMode)
            {
                if (_weekDate is null)
                {
                    throw new InvalidOperationException("Vui lòng chọn tuần đăng ký.");
                }

                var selectedDate = DateOnly.FromDateTime(_weekDate.Value);
                var weekStart = GetWeekStartMonday(selectedDate);
                if (selectedDate.DayOfWeek != DayOfWeek.Monday)
                {
                    throw new InvalidOperationException("Chỉ được chọn ngày thứ Hai của tuần cần đăng ký.");
                }

                var request = new ManagerRegisterWeekShiftDto
                {
                    EmployeeIds = employeeIds,
                    WeekStartDate = weekStart,
                    MonShiftCode = _monShiftCode,
                    TueShiftCode = _tueShiftCode,
                    WedShiftCode = _wedShiftCode,
                    ThuShiftCode = _thuShiftCode,
                    FriShiftCode = _friShiftCode,
                    SatShiftCode = _satShiftCode,
                    SunShiftCode = _sunShiftCode,
                    CreatedBy = string.IsNullOrWhiteSpace(CreatedBy) ? "manager" : CreatedBy,
                    Note = _registrationNote,
                    IsSplitShift = IsSplitShiftSelected,
                    MorningEnd = morningEnd,
                    EveningStart = eveningStart
                };

                var message = await ShiftFeatureService.RegisterWeekAsync(CompanyId, request);
                Snackbar.Add(string.IsNullOrWhiteSpace(message)
                    ? $"Đã đăng ký ca tuần {weekStart:dd/MM/yyyy} cho {employeeIds.Count} nhân viên."
                    : message,
                    Severity.Success);
            }
            else
            {
                if (_monthDate is null)
                {
                    throw new InvalidOperationException("Vui lòng chọn tháng đăng ký.");
                }

                var request = new ManagerRegisterMonthShiftDto
                {
                    EmployeeIds = employeeIds,
                    Year = _monthDate.Value.Year,
                    Month = _monthDate.Value.Month,
                    ShiftCode = _monthlyShiftCode,
                    IncludeSunday = _includeSundayForMonth,
                    CreatedBy = string.IsNullOrWhiteSpace(CreatedBy) ? "manager" : CreatedBy,
                    Note = _registrationNote,
                    IsSplitShift = IsSplitShiftSelected,
                    MorningEnd = morningEnd,
                    EveningStart = eveningStart
                };

                var message = await ShiftFeatureService.RegisterMonthAsync(CompanyId, request);
                Snackbar.Add(string.IsNullOrWhiteSpace(message)
                    ? $"Đã đăng ký ca tháng {_monthDate.Value:MM/yyyy} cho {employeeIds.Count} nhân viên."
                    : message,
                    Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(_selectedEmployeeIds.Count));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi đăng ký ca: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private bool HasAnyShift()
        => !string.IsNullOrWhiteSpace(_monShiftCode)
        || !string.IsNullOrWhiteSpace(_tueShiftCode)
        || !string.IsNullOrWhiteSpace(_wedShiftCode)
        || !string.IsNullOrWhiteSpace(_thuShiftCode)
        || !string.IsNullOrWhiteSpace(_friShiftCode)
        || !string.IsNullOrWhiteSpace(_satShiftCode)
        || !string.IsNullOrWhiteSpace(_sunShiftCode);

    private bool IsSplitShiftSelected
        => IsSplitShiftCode(_monthlyShiftCode)
        || IsSplitShiftCode(_monShiftCode)
        || IsSplitShiftCode(_tueShiftCode)
        || IsSplitShiftCode(_wedShiftCode)
        || IsSplitShiftCode(_thuShiftCode)
        || IsSplitShiftCode(_friShiftCode)
        || IsSplitShiftCode(_satShiftCode)
        || IsSplitShiftCode(_sunShiftCode);

    private string FormatSplitShiftTimes()
        => ParseTime(_morningEndText).HasValue && ParseTime(_eveningStartText).HasValue
            ? $"{ParseTime(_morningEndText)!.Value:hh\\:mm} - {ParseTime(_eveningStartText)!.Value:hh\\:mm}"
            : "chưa chọn giờ";

    private static TimeSpan? ParseTime(string? value)
    {
        return TimeSpan.TryParse(value, CultureInfo.InvariantCulture, out var parsed)
            || TimeSpan.TryParse(value, out parsed)
            ? parsed
            : null;
    }

    private static bool IsSplitShiftCode(string? shiftCode)
        => string.Equals(shiftCode?.Trim(), SplitShiftCode, StringComparison.OrdinalIgnoreCase);

    private static DateOnly GetWeekStartMonday(DateOnly date)
    {
        var offset = date.DayOfWeek == DayOfWeek.Sunday ? -6 : DayOfWeek.Monday - date.DayOfWeek;
        return date.AddDays(offset);
    }

    private bool IsWeeklyDateDisabled(DateTime date)
    {
        return DateOnly.FromDateTime(date).DayOfWeek != DayOfWeek.Monday;
    }

    private static bool IsMonthDateDisabled(DateTime date)
    {
        var currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        var selectedMonth = new DateTime(date.Year, date.Month, 1);
        return selectedMonth < currentMonth;
    }

    private static string GetShiftDisplayText(ShiftModel shift)
    {
        var shiftName = shift.ShiftCode.ToUpperInvariant() switch
        {
            "CC" => "Ca chiều",
            "CS" => "Ca sáng",
            "CT" => "Ca tối",
            "CSF" => "Ca fulltime sáng chiều",
            "CTF" => "Ca fulltime chiều tối",
            "BC" => "Làm 3 ca",
            _ => string.IsNullOrWhiteSpace(shift.ShiftName) ? shift.ShiftCode : shift.ShiftName
        };

        var timeRange = shift.StartTime == TimeSpan.Zero && shift.EndTime == TimeSpan.Zero
            ? "Chưa cấu hình thời gian"
            : $"{shift.StartTime:hh\\:mm} - {shift.EndTime:hh\\:mm}";

        return $"{shift.ShiftCode} - {shiftName} ({timeRange})";
    }

    private static int GetShiftOrder(string shiftCode) => shiftCode.ToUpperInvariant() switch
    {
        "CS" => 1,
        "CC" => 2,
        "CT" => 3,
        "CSF" => 4,
        "CTF" => 5,
        "BC" => 6,
        _ => 99
    };
}
