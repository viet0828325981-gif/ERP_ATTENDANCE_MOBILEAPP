@using ERP_PAYROLLMOBILE.Models.ManagerRole.ManagerShift
@using ERP_PAYROLLMOBILE.Models.ManagerRole.ManagerShiftRegistration
@using ERP_PAYROLLMOBILE.Services.Features.Shift
@using ERP_PAYROLLMOBILE.Services.RoleScope
@inject IShiftFeatureService ShiftFeatureService
@inject IRoleScopeService RoleScopeService
@inject ISnackbar Snackbar

<div class="shift-manager-actions">
    <div class="shift-action-title">Thao tác ca làm</div>

    <div class="shift-action-row">
        <label>EmployeeIds</label>
        <textarea value="@employeeIdsText" @onchange="args => employeeIdsText = args.Value?.ToString() ?? string.Empty" placeholder="Mỗi dòng một EmployeeId"></textarea>
    </div>
    <div class="shift-action-row">
        <label>ShiftCode</label>
        <input value="@shiftCode" @onchange="args => shiftCode = args.Value?.ToString()" />
    </div>
    <div class="shift-action-row">
        <label>Ngày bắt đầu tuần</label>
        <input type="date" value="@weekStartDate.ToString("yyyy-MM-dd")" @onchange="OnWeekStartChanged" />
    </div>
    <div class="shift-action-row">
        <label>Tháng</label>
        <input type="month" value="@selectedMonth.ToString("yyyy-MM")" @onchange="OnMonthChanged" />
    </div>
    <div class="shift-action-row">
        <label>Ghi chú</label>
        <input value="@note" @onchange="args => note = args.Value?.ToString()" />
    </div>

    <div class="shift-action-buttons">
        <button type="button" @onclick="RegisterWeekAsync" disabled="@isBusy">Đăng ký tuần</button>
        <button type="button" @onclick="RegisterMonthAsync" disabled="@isBusy">Đăng ký tháng</button>
    </div>

    <hr />

    <div class="shift-action-row">
        <label>RequestId</label>
        <input value="@requestIdText" @onchange="args => requestIdText = args.Value?.ToString()" placeholder="Guid đăng ký ca" />
    </div>
    <div class="shift-action-buttons">
        <button type="button" @onclick="ApproveAsync" disabled="@isBusy">Duyệt</button>
        <button type="button" @onclick="ApproveAllAsync" disabled="@isBusy">Duyệt tất cả</button>
        <button type="button" @onclick="RejectAsync" disabled="@isBusy">Từ chối</button>
    </div>
</div>

@code {
    private string employeeIdsText = string.Empty;
    private string? shiftCode;
    private DateOnly weekStartDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly selectedMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string? note;
    private string? requestIdText;
    private bool isBusy;

    private void OnWeekStartChanged(ChangeEventArgs args)
    {
        if (DateOnly.TryParse(args.Value?.ToString(), out var value))
        {
            weekStartDate = value;
        }
    }

    private void OnMonthChanged(ChangeEventArgs args)
    {
        if (DateOnly.TryParse($"{args.Value}-01", out var value))
        {
            selectedMonth = value;
        }
    }

    private async Task RegisterWeekAsync()
    {
        await RunAsync(async scope =>
        {
            var request = new ManagerRegisterWeekShiftDto
            {
                EmployeeIds = GetEmployeeIds(),
                WeekStartDate = weekStartDate,
                MonShiftCode = shiftCode,
                TueShiftCode = shiftCode,
                WedShiftCode = shiftCode,
                ThuShiftCode = shiftCode,
                FriShiftCode = shiftCode,
                SatShiftCode = shiftCode,
                SunShiftCode = shiftCode,
                CreatedBy = scope.EmployeeId,
                Note = note
            };

            var message = await ShiftFeatureService.RegisterWeekAsync(scope.CompanyId, request);
            Snackbar.Add(string.IsNullOrWhiteSpace(message) ? "Đã đăng ký ca theo tuần." : message, Severity.Success);
        });
    }

    private async Task RegisterMonthAsync()
    {
        await RunAsync(async scope =>
        {
            var request = new ManagerRegisterMonthShiftDto
            {
                EmployeeIds = GetEmployeeIds(),
                Year = selectedMonth.Year,
                Month = selectedMonth.Month,
                ShiftCode = shiftCode,
                IncludeSunday = false,
                CreatedBy = scope.EmployeeId,
                Note = note
            };

            var message = await ShiftFeatureService.RegisterMonthAsync(scope.CompanyId, request);
            Snackbar.Add(string.IsNullOrWhiteSpace(message) ? "Đã đăng ký ca theo tháng." : message, Severity.Success);
        });
    }

    private async Task ApproveAsync()
    {
        if (!TryGetRequestId(out var requestId))
        {
            return;
        }

        await RunAsync(async scope =>
        {
            var request = new ManagerApproveShiftRegistrationDto
            {
                RequestId = requestId,
                ApprovedBy = scope.EmployeeId
            };

            var message = await ShiftFeatureService.ApproveRegistrationAsync(scope.CompanyId, request);
            Snackbar.Add(string.IsNullOrWhiteSpace(message) ? "Đã duyệt đăng ký ca." : message, Severity.Success);
        });
    }

    private async Task ApproveAllAsync()
    {
        await RunAsync(async scope =>
        {
            var request = new ManagerApproveAllShiftRegistrationDto
            {
                DepartmentId = scope.DepartmentId,
                ApprovedBy = scope.EmployeeId
            };

            var result = await ShiftFeatureService.ApproveAllRegistrationsAsync(scope.CompanyId, request);
            Snackbar.Add($"Đã duyệt {result.ApprovedCount} đăng ký ca.", Severity.Success);
        });
    }

    private async Task RejectAsync()
    {
        if (!TryGetRequestId(out var requestId))
        {
            return;
        }

        await RunAsync(async scope =>
        {
            var request = new ManagerRejectShiftRegistrationDto
            {
                RequestId = requestId,
                RejectedBy = scope.EmployeeId
            };

            var message = await ShiftFeatureService.RejectRegistrationAsync(scope.CompanyId, request);
            Snackbar.Add(string.IsNullOrWhiteSpace(message) ? "Đã từ chối đăng ký ca." : message, Severity.Success);
        });
    }

    private List<string> GetEmployeeIds()
    {
        return employeeIdsText
            .Split(new[] { '\r', '\n', ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
    }

    private bool TryGetRequestId(out Guid requestId)
    {
        if (Guid.TryParse(requestIdText, out requestId))
        {
            return true;
        }

        Snackbar.Add("RequestId không hợp lệ.", Severity.Warning);
        return false;
    }

    private async Task RunAsync(Func<RoleScopeState, Task> action)
    {
        isBusy = true;
        try
        {
            var scope = await RoleScopeService.LoadAsync();
            await action(scope);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thực hiện được thao tác ca: {ex.Message}", Severity.Error);
        }
        finally
        {
            isBusy = false;
        }
    }
}
