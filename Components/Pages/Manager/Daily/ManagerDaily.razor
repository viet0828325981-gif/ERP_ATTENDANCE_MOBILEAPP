@page "/manager/daily"
@implements IDisposable
@using System.Globalization
@using ERP_PAYROLLMOBILE.Models
@using ERP_PAYROLLMOBILE.Models.ManagerRole.ManagerAttendance
@using ERP_PAYROLLMOBILE.Services.Features.Daily
@using ERP_PAYROLLMOBILE.Services.RoleScope
@inject IDailyFeatureService DailyFeatureService
@inject IRoleScopeService RoleScopeService
@inject ISnackbar Snackbar

<PageTitle>Quản lý chấm công</PageTitle>

<RoleGuard AllowedRole="@ERP_PAYROLLMOBILE.Services.RoleScope.AppRole.Manager">
    <section class="attendance-page">
        <div class="attendance-content">
            <div class="attendance-header-card">
                <div class="manager-attendance-daily-header">
                    <div class="manager-attendance-daily-heading">
                        <p class="page-title">Chấm công</p>
                        <p class="page-subtitle">Theo dõi chấm công nhân viên .</p>
                    </div>
                    <div class="manager-attendance-daily-actions-card">
                        <div class="manager-attendance-daily-main-actions">
                            @if (searchMode == ManagerAttendanceSearchMode.Day)
                            {
                                <label class="attendance-field manager-attendance-daily-date-input full-width">
                                    <span>Ngày</span>
                                    <input type="date" value="@selectedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @onchange="OnDateChangedAsync" />
                                </label>
                            }
                            else
                            {
                                <div class="attendance-filters manager-attendance-daily-month-group">
                                    <div class="attendance-field">
                                        <label>Tháng</label>
                                        <select value="@selectedMonth.Month" @onchange="OnMonthChangedAsync">
                                            @for (var month = 1; month <= 12; month++)
                                            {
                                                <option value="@month">Tháng @month</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="attendance-field">
                                        <label>Năm</label>
                                        <input type="number" min="2000" max="2100" value="@selectedMonth.Year" @onchange="OnYearChangedAsync" />
                                    </div>
                                </div>
                            }

                        <button type="button" class="search-btn manager-attendance-sync-button" @onclick="SyncAsync" disabled="@isSyncing">
                            @(isSyncing ? "Đang đồng bộ..." : "Đồng bộ")
                            </button>
                        </div>

                        <div class="manager-attendance-daily-mode-stack">
                            <button type="button" class="mode-option manager-attendance-mode-button @(searchMode == ManagerAttendanceSearchMode.Day ? "active" : null)" @onclick="() => SetSearchModeAsync(ManagerAttendanceSearchMode.Day)">Theo ngày</button>
                            <button type="button" class="mode-option manager-attendance-mode-button @(searchMode == ManagerAttendanceSearchMode.Month ? "active" : null)" @onclick="() => SetSearchModeAsync(ManagerAttendanceSearchMode.Month)">Theo tháng</button>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="attendance-error">@errorMessage</div>
            }
            else if (isLoading)
            {
                <div class="attendance-loading">Đang tải dữ liệu chấm công phòng ban...</div>
            }
            else
            {
                <div class="stats-row">
                    @for (var i = 0; i < SummaryItems.Count; i++)
                    {
                        var item = SummaryItems[i];
                        <div class="stat-card @GetSummaryCardClass(i)">
                            <p class="stat-value">@item.Value</p>
                            <p class="stat-label">@item.Title</p>
                        </div>
                    }
                </div>

                @if (records.Count == 0)
                {
                    <div class="attendance-empty">Không có dữ liệu chấm công trong bộ lọc đã chọn.</div>
                }
                else
                {
                    <ul class="attendance-list">
                        @foreach (var record in records)
                        {
                            var isOpen = expandedKeys.Contains(GetRecordKey(record));
                            <li class="attendance-card @(isOpen ? "open" : null)">
                                <button type="button" class="attendance-row" @onclick="() => ToggleRecord(record)">
                                    <div class="attendance-date">
                                        <p class="day">@record.WorkDate.ToString("dd/MM", CultureInfo.InvariantCulture)</p>
                                        <p class="weekday">@record.WorkDate.ToString("ddd", VietnameseCulture)</p>
                                    </div>

                                    <div class="attendance-date">
                                        <p class="FullName">@record.FullName</p>

                                    </div>

                                    <span class="attendance-shift @GetShiftBadgeClass(record.ShiftCode)">@GetShiftLabel(record.ShiftCode)</span>

                                    <div class="attendance-times">
                                        <p class="times">@FormatTimeRange(record)</p>
                                    </div>

                                    <div class="attendance-work">
                                        <p class="work-count">@record.WorkDayFactor.ToString("0.##", CultureInfo.InvariantCulture) công</p>
                                    </div>

                                    <span class="expand-btn" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="m6 9 6 6 6-6" />
                                        </svg>
                                    </span>
                                </button>

                                <div class="attendance-detail">
                                    <div class="detail-row">
                                        <span class="attendance-detail-label">Nhân viên</span>
                                        <span class="attendance-detail-value">@record.EmployeeId - @record.FullName</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="attendance-detail-label">Check in / out</span>
                                        <span class="attendance-detail-value">@FormatTimeRange(record)</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="attendance-detail-label">Trạng thái</span>
                                        <span class="attendance-detail-value">@GetAttendanceStatusLabel(record)</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="attendance-detail-label">Đi trễ / về sớm</span>
                                        <span class="attendance-detail-value">@GetLateEarlyLabel(record)</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="attendance-detail-label">WorkType</span>
                                        <span class="attendance-detail-value">@(string.IsNullOrWhiteSpace(record.WorkType) ? "-" : record.WorkType)</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="attendance-detail-label">Request đang chờ</span>
                                        <span class="attendance-detail-value">@(string.IsNullOrWhiteSpace(record.PendingRequestTypes) ? "-" : record.PendingRequestTypes)</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="attendance-detail-label">Request đã duyệt</span>
                                        <span class="attendance-detail-value">@(string.IsNullOrWhiteSpace(record.ApprovedRequestTypes) ? "-" : record.ApprovedRequestTypes)</span>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            }
        </div>
    </section>

</RoleGuard>

@code {
    private static readonly CultureInfo VietnameseCulture = new("vi-VN");
    private readonly List<AttendanceDailyViewModel> records = new();
    private readonly HashSet<string> expandedKeys = new(StringComparer.Ordinal);
    private ManagerAttendanceSearchMode searchMode = ManagerAttendanceSearchMode.Day;
    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly selectedMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private Guid? lastLoadedDepartmentId;
    private bool isLoading;
    private bool isSyncing;
    private string? errorMessage;

    private IReadOnlyList<(string Title, string Value)> SummaryItems =>
    [
        ("Tổng công", records.Sum(item => item.WorkDayFactor).ToString("0.##", CultureInfo.InvariantCulture)),
        ("Đi trễ", records.Count(item => (item.LateMinutes ?? 0) > 0).ToString(CultureInfo.InvariantCulture)),
        ("Về sớm", records.Count(item => (item.EarlyLeaveMinutes ?? 0) > 0).ToString(CultureInfo.InvariantCulture)),
        ("Vắng", records.Count(item => string.Equals(item.AttendanceCode, "ABSENT", StringComparison.OrdinalIgnoreCase)).ToString(CultureInfo.InvariantCulture))
    ];

    protected override async Task OnInitializedAsync()
    {
        RoleScopeService.Changed += OnRoleScopeChanged;
        await RoleScopeService.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var scope = await RoleScopeService.LoadAsync();
        if (!scope.DepartmentId.HasValue)
        {
            records.Clear();
            errorMessage = "Hãy chọn phòng ban ở MainLayout để xem dữ liệu.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        isLoading = true;
        errorMessage = null;
        try
        {
            var data = searchMode == ManagerAttendanceSearchMode.Day
                ? await DailyFeatureService.GetManagerDailyByDateAsync(scope.CompanyId, selectedDate)
                : await DailyFeatureService.GetManagerDailyByPeriodAsync(scope.CompanyId, GetMonthRange().From, GetMonthRange().To);

            records.Clear();
            records.AddRange(data
                .Where(item => item.DepartmentId == scope.DepartmentId)
                .OrderByDescending(item => item.WorkDate)
                .ThenBy(item => item.EmployeeId));
            expandedKeys.Clear();
            lastLoadedDepartmentId = scope.DepartmentId;
        }
        catch (Exception ex)
        {
            records.Clear();
            errorMessage = $"Không tải được dữ liệu chấm công phòng ban: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SyncAsync()
    {
        var scope = await RoleScopeService.LoadAsync();
        if (!scope.DepartmentId.HasValue)
        {
            Snackbar.Add("Hãy chọn phòng ban trước khi đồng bộ chấm công.", Severity.Warning);
            return;
        }

        var (fromDate, toDate) = searchMode == ManagerAttendanceSearchMode.Day
            ? (selectedDate, selectedDate)
            : GetMonthRange();

        isSyncing = true;
        try
        {
            var request = new ManagerAttendanceDailySyncDto
            {
                From = fromDate,
                To = toDate
            };

            var message = await DailyFeatureService.SyncRangeAsync(scope.CompanyId, request);
            Snackbar.Add(string.IsNullOrWhiteSpace(message) ? "Đã đồng bộ chấm công." : message, Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không đồng bộ được chấm công: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSyncing = false;
        }
    }

    private async Task SetSearchModeAsync(ManagerAttendanceSearchMode mode)
    {
        if (searchMode == mode)
        {
            return;
        }

        searchMode = mode;
        await LoadAsync();
    }

    private async Task OnDateChangedAsync(ChangeEventArgs args)
    {
        if (DateOnly.TryParse(args.Value?.ToString(), out var value))
        {
            selectedDate = value;
            await LoadAsync();
        }
    }

    private async Task OnMonthChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var month))
        {
            selectedMonth = new DateOnly(selectedMonth.Year, month, 1);
            await LoadAsync();
        }
    }

    private async Task OnYearChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var year))
        {
            selectedMonth = new DateOnly(year, selectedMonth.Month, 1);
            await LoadAsync();
        }
    }

    private void ToggleRecord(AttendanceDailyViewModel record)
    {
        var key = GetRecordKey(record);
        if (!expandedKeys.Add(key))
        {
            expandedKeys.Remove(key);
        }
    }

    private static string GetRecordKey(AttendanceDailyViewModel record)
    {
        return $"{record.EmployeeId}:{record.WorkDate:yyyyMMdd}";
    }

    private static string FormatTimeRange(AttendanceDailyViewModel record)
    {
        return $"{FormatTime(record.CheckInTime)} - {FormatTime(record.CheckOutTime)}";
    }

    private static string FormatTime(DateTime? value)
    {
        return value?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? "--:--";
    }

    private static string GetShiftLabel(string? shiftCode)
    {
        return string.IsNullOrWhiteSpace(shiftCode) ? "--" : shiftCode;
    }

    private static string GetShiftBadgeClass(string? shiftCode)
    {
        return (shiftCode ?? string.Empty).Trim().ToUpperInvariant() switch
        {
            "CS" or "CC" or "CT" => "shift-basic",
            "CSF" or "CTF" or "CTC" => "shift-full",
            "BC" or "CG" => "shift-flex",
            _ => "shift-basic"
        };
    }

    private static string GetAttendanceStatusLabel(AttendanceDailyViewModel record)
    {
        return string.IsNullOrWhiteSpace(record.AttendanceCode) ? "-" : record.AttendanceCode;
    }

    private static string GetLateEarlyLabel(AttendanceDailyViewModel record)
    {
        var late = record.LateMinutes ?? 0;
        var early = record.EarlyLeaveMinutes ?? 0;
        return $"{late} / {early} phút";
    }

    private static string GetSummaryCardClass(int index)
    {
        return index switch
        {
            0 => "stat-accent",
            1 => "stat-warning",
            2 => "stat-warning",
            _ => "stat-danger"
        };
    }

    private (DateOnly From, DateOnly To) GetMonthRange()
    {
        var fromDate = new DateOnly(selectedMonth.Year, selectedMonth.Month, 1);
        var toDate = new DateOnly(selectedMonth.Year, selectedMonth.Month, DateTime.DaysInMonth(selectedMonth.Year, selectedMonth.Month));
        return (fromDate, toDate);
    }

    private async void OnRoleScopeChanged()
    {
        if (RoleScopeService.Current.DepartmentId != lastLoadedDepartmentId)
        {
            await LoadAsync();
        }
    }

    public void Dispose()
    {
        RoleScopeService.Changed -= OnRoleScopeChanged;
    }

    private enum ManagerAttendanceSearchMode
    {
        Day,
        Month
    }
}
