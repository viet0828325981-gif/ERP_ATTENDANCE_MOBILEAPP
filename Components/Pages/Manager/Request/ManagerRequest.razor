@page "/manager/requests"
@implements IDisposable
@using System.Globalization
@using ERP_PAYROLLMOBILE.Models.EmployeeRequest
@using ERP_PAYROLLMOBILE.Models.ManagerRole.ManagerRequests
@using ERP_PAYROLLMOBILE.Services.Features.Requests
@using ERP_PAYROLLMOBILE.Services.RoleScope
@inject IRequestFeatureService RequestFeatureService
@inject IRoleScopeService RoleScopeService
@inject ISnackbar Snackbar

<PageTitle>Quản lý yêu cầu</PageTitle>

<RoleGuard AllowedRole="@ERP_PAYROLLMOBILE.Services.RoleScope.AppRole.Manager">
    <section class="employee-request-page">
        <div class="request-page-content">
            <div class="request-intro-row">
                <p class="request-intro-text">Theo dõi và xử lý yêu cầu công của phòng ban đã chọn.</p>
                <button type="button" class="request-primary-button" @onclick="LoadAsync" disabled="@isLoading">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M4 4v5h.582m14.836 2A8.001 8.001 0 0 0 4.582 9m0 0H9" />
                        <path d="M20 20v-5h-.581m0 0A8.003 8.003 0 0 1 4.582 15m14.837 0H15" />
                    </svg>
                    <span>@(isLoading ? "Đang tải" : "Tải lại")</span>
                </button>
            </div>

            <div class="request-filters">
                <div class="filter-field">
                    <label>Tháng</label>
                    <select value="@selectedMonth.Month" @onchange="OnMonthChangedAsync">
                        @for (var month = 1; month <= 12; month++)
                        {
                            <option value="@month">Tháng @month</option>
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <label>Năm</label>
                    <input type="number" min="2000" max="2100" value="@selectedMonth.Year" @onchange="OnYearChangedAsync" />
                </div>
                <div class="filter-field">
                    <label>Loại yêu cầu</label>
                    <select value="@selectedRequestType" @onchange="OnRequestTypeChangedAsync">
                        <option value="">Tất cả</option>
                        @foreach (var type in requestTypes)
                        {
                            <option value="@type.RequestType">@type.RequestName</option>
                        }
                    </select>
                </div>
            </div>

            <div class="request-filters">
                <div class="filter-field">
                    <label>Trạng thái</label>
                    <select value="@statusText" @onchange="OnStatusChangedAsync">
                        <option value="">Tất cả</option>
                        <option value="0">Chờ duyệt</option>
                        <option value="1">Đã duyệt</option>
                        <option value="2">Từ chối</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label>Từ khóa mã NV</label>
                    <input value="@employeeKeyword" @onchange="OnEmployeeKeywordChangedAsync" placeholder="Ví dụ: EMP001" />
                </div>
                <div class="filter-field">
                    <label>&nbsp;</label>
                    <div class="request-intro-text">@requests.Count yêu cầu</div>
                </div>
            </div>

            <div class="info-card open">
                <div class="info-header">
                    <div class="info-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                    </div>
                    <div class="info-text">
                        <div class="info-title">Thao tác manager</div>
                        <div class="info-sub">Duyệt, từ chối, tạo hàng loạt và chạy job tháng</div>
                    </div>
                </div>
                <div class="info-body" style="max-height:700px;padding:0 16px 16px;">
                    <RequestManagerActions />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="request-alert">@errorMessage</div>
            }

            @if (isLoading)
            {
                <div class="request-empty">Đang tải dữ liệu yêu cầu công...</div>
            }
            else if (!FilteredRequests.Any())
            {
                <div class="request-empty">Không có yêu cầu công trong kỳ đã chọn.</div>
            }
            else
            {
                <ul class="request-list">
                    @foreach (var request in FilteredRequests)
                    {
                        <li class="request-card @(expandedRequestId == request.Id ? "open" : null)">
                            <button type="button" class="request-summary" @onclick="() => ToggleRequest(request.Id)">
                                <span class="request-icon @GetRequestIconCssClass(request.RequestType)" aria-hidden="true">
                                    @switch (GetRequestIconKey(request.RequestType))
                                    {
                                        case "clock-check":
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="7" /><path d="M12 9v3l2 2M16.5 5.5l1-1M7.5 5.5l-1-1M16 16l2 2 4-4" /></svg>
                                            break;
                                        case "calendar-week":
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2" /><path d="M16 2v4M8 2v4M3 10h18M7 14h3M14 14h3M7 18h3" /></svg>
                                            break;
                                        case "gift":
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12v8H4v-8M2 7h20v5H2z" /><path d="M12 7v13M12 7H8.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7zm0 0h3.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7z" /></svg>
                                            break;
                                        case "device-laptop":
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="5" width="16" height="11" rx="1.5" /><path d="M2 19h20" /></svg>
                                            break;
                                        case "cloud":
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 18a4 4 0 1 1 .6-7.96A5 5 0 0 1 17 8a4 4 0 1 1 0 8H7z" /></svg>
                                            break;
                                        default:
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 18h.01" /><path d="M9 16a4 4 0 0 1 6 0" /><path d="M6 13a8 8 0 0 1 12 0" /><path d="M3 10a12 12 0 0 1 18 0" /></svg>
                                            break;
                                    }
                                </span>
                                <span class="request-info">
                                    <span class="request-title">@GetRequestTypeLabel(request.RequestType)</span>
                                    <span class="request-date">@request.TargetDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</span>
                                </span>
                                <span class="status-badge @GetStatusBadgeClass(request.Status)">@GetStatusText(request.Status)</span>
                                <span class="expand-btn" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="m6 9 6 6 6-6" />
                                    </svg>
                                </span>
                            </button>

                            <div class="request-details">
                                <div class="request-detail-row"><span class="request-detail-label">Nhân viên</span><span class="request-detail-value">@(string.IsNullOrWhiteSpace(request.FullName) ? request.EmployeeId : request.FullName)</span></div>
                                <div class="request-detail-row"><span class="request-detail-label">Mã nhân viên</span><span class="request-detail-value">@request.EmployeeId</span></div>
                                <div class="request-detail-row"><span class="request-detail-label">Ngày thực hiện</span><span class="request-detail-value">@(request.SourceDate?.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) ?? "-")</span></div>
                                <div class="request-detail-row"><span class="request-detail-label">Số phút</span><span class="request-detail-value">@(request.MinutesAffected == 0 ? "-" : request.MinutesAffected.ToString(CultureInfo.InvariantCulture))</span></div>
                                <div class="request-detail-row"><span class="request-detail-label">Phút xác nhận</span><span class="request-detail-value">@request.ConfirmedMinutes</span></div>
                                <div class="request-detail-row"><span class="request-detail-label">WorkType</span><span class="request-detail-value">@(request.WorkType ?? "-")</span></div>
                                <div class="request-detail-row"><span class="request-detail-label">Người tạo</span><span class="request-detail-value">@GetCreatedLabel(request)</span></div>
                                <div class="request-detail-row"><span class="request-detail-label">Ngày tạo</span><span class="request-detail-value">@request.CreatedAt.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</span></div>
                                <div class="request-detail-row"><span class="request-detail-label">Người duyệt</span><span class="request-detail-value">@(request.ApprovedBy ?? "-")</span></div>
                                <div class="request-detail-row">
                                    <span class="request-detail-label">Nhóm</span>
                                    @if (request.IsGroupedOnline)
                                    {
                                        <button type="button" class="link-button" @onclick:stopPropagation="true" @onclick="() => OpenGroupDetailAsync(request)">Xem nhóm</button>
                                    }
                                    else
                                    {
                                        <span class="request-detail-value">-</span>
                                    }
                                </div>
                                <div class="reason-box inline-reason">
                                    <span>Lý do</span>
                                    <p>@(string.IsNullOrWhiteSpace(request.Reason) ? "-" : request.Reason)</p>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

    </section>
</RoleGuard>

@if (showGroupDetailModal)
{
    <div class="request-modal-backdrop" @onclick="CloseGroupDetail">
        <div class="request-modal large" @onclick:stopPropagation="true">
            <div class="request-modal-header">
                <div>
                    <h2>Chi tiết nhóm online</h2>
                    <p>@groupDetailTitle</p>
                </div>
                <button type="button" class="close-button" @onclick="CloseGroupDetail">✕</button>
            </div>

            @if (isGroupLoading)
            {
                <div class="request-empty">Đang tải chi tiết nhóm online...</div>
            }
            else if (!string.IsNullOrWhiteSpace(groupDetailErrorMessage))
            {
                <div class="request-alert">@groupDetailErrorMessage</div>
            }
            else if (groupRequests.Count == 0)
            {
                <div class="request-empty">Không có dữ liệu nhóm online.</div>
            }
            else
            {
                <div class="request-table compact-table">
                    <div class="request-table-head compact-group-header">
                        <span>Ngày</span>
                        <span>Loại</span>
                        <span>Shift</span>
                        <span>Trạng thái</span>
                        <span>Lý do</span>
                    </div>
                    @foreach (var item in groupRequests)
                    {
                        <div class="request-table-row compact-group-row">
                            <div>@item.TargetDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</div>
                            <div>@GetRequestTypeLabel(item.RequestType)</div>
                            <div>@(item.ShiftCode ?? "-")</div>
                            <div>@GetStatusText(item.Status)</div>
                            <div>@(item.Reason ?? "-")</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private readonly List<WorkRequestModel> requests = new();
    private readonly List<ManagerRequestTypeModel> requestTypes = new();
    private readonly List<WorkRequestModel> groupRequests = new();
    private DateOnly selectedMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private Guid? expandedRequestId;
    private Guid? lastLoadedDepartmentId;
    private string? selectedRequestType;
    private string? statusText;
    private string? employeeKeyword;
    private bool isLoading;
    private bool isGroupLoading;
    private bool showGroupDetailModal;
    private string? errorMessage;
    private string? groupDetailErrorMessage;
    private string groupDetailTitle = string.Empty;

    private IEnumerable<WorkRequestModel> FilteredRequests => string.IsNullOrWhiteSpace(employeeKeyword)
        ? requests
        : requests.Where(item => item.EmployeeId.Contains(employeeKeyword, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(item.FullName) && item.FullName.Contains(employeeKeyword, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        RoleScopeService.Changed += OnRoleScopeChanged;
        await RoleScopeService.LoadAsync();
        await LoadRequestTypesAsync();
        await LoadAsync();
    }

    private async Task LoadRequestTypesAsync()
    {
        try
        {
            requestTypes.Clear();
            requestTypes.AddRange(await RequestFeatureService.GetManagerRequestTypesAsync());
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không tải được danh mục loại yêu cầu: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadAsync()
    {
        var scope = await RoleScopeService.LoadAsync();
        if (!scope.DepartmentId.HasValue)
        {
            requests.Clear();
            errorMessage = "Hãy chọn phòng ban ở MainLayout để xem yêu cầu công.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        isLoading = true;
        errorMessage = null;
        try
        {
            int? status = null;
            if (int.TryParse(statusText, out var parsedStatus))
            {
                status = parsedStatus;
            }

            var data = await RequestFeatureService.GetManagerRequestsAsync(
                scope.CompanyId,
                scope.DepartmentId.Value,
                selectedMonth.Year,
                selectedMonth.Month,
                string.IsNullOrWhiteSpace(selectedRequestType) ? null : selectedRequestType,
                status);

            requests.Clear();
            requests.AddRange(data.OrderByDescending(item => item.CreatedAt));
            expandedRequestId = null;
            lastLoadedDepartmentId = scope.DepartmentId;
        }
        catch (Exception ex)
        {
            requests.Clear();
            errorMessage = $"Không tải được yêu cầu công phòng ban: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleRequest(Guid requestId)
    {
        expandedRequestId = expandedRequestId == requestId ? null : requestId;
    }

    private async Task OnMonthChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var month))
        {
            selectedMonth = new DateOnly(selectedMonth.Year, month, 1);
            await LoadAsync();
        }
    }

    private async Task OnYearChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var year))
        {
            selectedMonth = new DateOnly(year, selectedMonth.Month, 1);
            await LoadAsync();
        }
    }

    private async Task OnRequestTypeChangedAsync(ChangeEventArgs args)
    {
        selectedRequestType = args.Value?.ToString();
        await LoadAsync();
    }

    private async Task OnStatusChangedAsync(ChangeEventArgs args)
    {
        statusText = args.Value?.ToString();
        await LoadAsync();
    }

    private Task OnEmployeeKeywordChangedAsync(ChangeEventArgs args)
    {
        employeeKeyword = args.Value?.ToString();
        return Task.CompletedTask;
    }

    private async Task OpenGroupDetailAsync(WorkRequestModel request)
    {
        try
        {
            var scope = await RoleScopeService.LoadAsync();
            groupDetailTitle = $"{(string.IsNullOrWhiteSpace(request.FullName) ? request.EmployeeId : request.FullName)} · {GetRequestTypeLabel(request.RequestType)}";
            groupDetailErrorMessage = null;
            showGroupDetailModal = true;
            isGroupLoading = true;
            groupRequests.Clear();

            groupRequests.AddRange(await RequestFeatureService.GetOnlineGroupDetailAsync(scope.CompanyId, request.EmployeeId, request.RequestType, request.CreatedAt));
        }
        catch (Exception ex)
        {
            groupDetailErrorMessage = $"Không tải được chi tiết nhóm online: {ex.Message}";
        }
        finally
        {
            isGroupLoading = false;
        }
    }

    private void CloseGroupDetail()
    {
        showGroupDetailModal = false;
    }

    private async void OnRoleScopeChanged()
    {
        if (RoleScopeService.Current.DepartmentId != lastLoadedDepartmentId)
        {
            await LoadAsync();
        }
    }

    public void Dispose()
    {
        RoleScopeService.Changed -= OnRoleScopeChanged;
    }

    private static string GetRequestTypeLabel(string? requestType)
    {
        return requestType switch
        {
            "FORGOT_CHECK" => "Quên chấm công",
            "MAKEUP_HOUR" => "Bù công",
            "WORK_OVERTIME" => "Tăng ca",
            "WORK_HOLIDAY" => "Làm ngày lễ",
            "WORK_WEEKEND" => "Làm cuối tuần",
            "WORK_ONLINE" => "Làm online",
            "WORK_ONLINE_HOLIDAY" => "Online ngày lễ",
            "WORK_ONLINE_WEEKEND" => "Online cuối tuần",
            _ => string.IsNullOrWhiteSpace(requestType) ? "Không xác định" : requestType
        };
    }

    private static string GetRequestIconKey(string? requestType)
    {
        return requestType switch
        {
            "FORGOT_CHECK" => "clock-check",
            "MAKEUP_HOUR" => "calendar-week",
            "WORK_OVERTIME" => "clock-check",
            "WORK_HOLIDAY" or "WORK_WEEKEND" => "gift",
            "WORK_ONLINE" or "WORK_ONLINE_HOLIDAY" or "WORK_ONLINE_WEEKEND" => "device-laptop",
            _ => "cloud"
        };
    }

    private static string GetRequestIconCssClass(string? requestType)
    {
        return requestType switch
        {
            "FORGOT_CHECK" => "icon-blue",
            "MAKEUP_HOUR" => "icon-amber",
            "WORK_OVERTIME" => "icon-teal",
            "WORK_HOLIDAY" or "WORK_WEEKEND" => "icon-purple",
            "WORK_ONLINE" or "WORK_ONLINE_HOLIDAY" or "WORK_ONLINE_WEEKEND" => "icon-indigo",
            _ => "icon-pink"
        };
    }

    private static string GetStatusText(int status)
    {
        return status switch
        {
            1 => "Đã duyệt",
            2 => "Từ chối",
            _ => "Chờ duyệt"
        };
    }

    private static string GetStatusBadgeClass(int status)
    {
        return status switch
        {
            1 => "status-approved",
            2 => "status-rejected",
            _ => "status-pending"
        };
    }

    private static string GetCreatedLabel(WorkRequestModel request)
    {
        return string.IsNullOrWhiteSpace(request.CreatedBy) ? request.EmployeeId : request.CreatedBy;
    }
}
