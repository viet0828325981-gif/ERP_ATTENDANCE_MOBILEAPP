@page "/manager/shift"
@implements IDisposable
@using System.Globalization
@using ERP_PAYROLLMOBILE.Models.ManagerRole.ManagerShift
@using ERP_PAYROLLMOBILE.Services.Features.Shift
@using ERP_PAYROLLMOBILE.Services.RoleScope
@using ERP_PAYROLLMOBILE.Services.Ui
@inject IDialogService ShiftDialogService
@inject IShiftFeatureService ShiftFeatureService
@inject IRoleScopeService RoleScopeService
@inject NavigationManager Navigation
@inject PullToRefreshService PullToRefreshService
@inject ISnackbar Snackbar

<PageTitle>Lịch ca nhân viên</PageTitle>

<style>
    .manager-shift-stack {
        min-height: calc(100vh - 56px);
        align-items: stretch;
    }

    .manager-shift-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .manager-shift-actions {
        display: flex;
        gap: 16px;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .manager-shift-filters {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: clamp(8px, 1vw, 12px);
    }

    .manager-shift-filter-search {
        flex: 1 1 260px;
    }

    .manager-shift-month {
        flex: 0 0 90px;
    }

    .manager-shift-year {
        flex: 0 0 90px;
    }


    .manager-shift-toolbar-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

    @@media (max-width: 960px) {
        .manager-shift-stack {
            flex-direction: column !important;
        }

        .manager-shift-header {
            flex-direction: column;
            align-items: stretch;
        }

        .manager-shift-actions {
            width: 100%;
            flex-direction: column;
            align-items: stretch;
            gap: 8px;
        }

        .manager-shift-filters,
        .manager-shift-toolbar-actions {
            width: 100%;
            flex-direction: column;
            align-items: stretch;
        }


        .manager-shift-actions > * {
            width: 100% !important;
        }
    }
</style>

<RoleGuard AllowedRole="@ERP_PAYROLLMOBILE.Services.RoleScope.AppRole.Manager">
    <MudStack Row="true" Spacing="0" Class="manager-shift-stack">
        <MudPaper Class="pa-4" Style="flex:1; min-width:0; overflow-x:auto; overflow-y:visible;">
            <div class="manager-shift-header">
                <div>
                    <MudText Typo="Typo.h5" Class="page-title">LỊCH CA NHÂN VIÊN</MudText>
                </div>

                <div class="manager-shift-actions">
                    <div class="manager-shift-actions">
                        <div class="manager-shift-filters">

                            <MudTextField T="string"
                                          @bind-Value="_searchText"
                                          Placeholder="Tìm theo mã hoặc tên nhân viên"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          AdornmentAriaLabel="Tìm nhân viên"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Class="manager-shift-filter-search" />

                            <MudSelect T="int"
                                       Value="_selectedMonth"
                                       ValueChanged="OnSelectedMonthChangedAsync"
                                       Label="Tháng"
                                       Margin="Margin.Dense"
                                       Class="manager-shift-month">

                                @for (int m = 1; m <= 12; m++)
                                {
                                    <MudSelectItem T="int" Value="@m">
                                        Tháng @m
                                    </MudSelectItem>
                                }

                            </MudSelect>

                            <MudNumericField T="int"
                                             Value="_selectedYear"
                                             ValueChanged="OnSelectedYearChangedAsync"
                                             Label="Năm"
                                             Min="2020"
                                             Max="2099"
                                             Immediate="true"
                                             Margin="Margin.Dense"
                                             Class="manager-shift-year" />

                        </div>
                    </div>

                    <div class="manager-shift-toolbar-actions">
                        <MudButton Variant="Variant.Outlined" Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.CalendarMonth"
                                   Disabled="_loading || _openingScheduleDialog"
                                   OnClick="OpenWeeklyScheduleDialogAsync">
                            @if (_openingScheduleDialog)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <text>Đang mở...</text>
                            }
                            else
                            {
                                <text>Xem bảng lịch ca</text>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.EventAvailable"
                                   Disabled="_loading || _openingRegistrationDialog || !_employeeSummaries.Any()"
                                   OnClick="OpenRegistrationDialogAsync">
                            @if (_openingRegistrationDialog)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <text>Đang mở...</text>
                            }
                            else
                            {
                                <text>Đăng ký ca</text>
                            }
                        </MudButton>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
            }

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                var filteredSummaries = GetFilteredSummaries();


                <MudPaper Class="pa-3 mb-4" Outlined="true">
                    <div class="d-flex justify-space-between align-center flex-wrap gap-3 mb-2">
                        <MudText Typo="Typo.subtitle2">Nhân viên đăng ký ca</MudText>
                        <div class="d-flex gap-2 flex-wrap">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SelectAllFilteredEmployees">Chọn tất cả đang lọc</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearSelectedEmployees">Bỏ chọn</MudButton>
                        </div>
                    </div>
                </MudPaper>

                @if (filteredSummaries.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">
                        Không có nhân viên phù hợp với phòng ban hoặc từ khóa đã chọn.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="filteredSummaries" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm"
                              OnRowClick="@((TableRowClickEventArgs<EmployeeShiftSummaryModel> args) => OnSummaryRowClickAsync(args))">
                        <HeaderContent>
                            <MudTh Style="width:56px;"></MudTh>
                            <MudTh>Mã NV</MudTh>
                            <MudTh>Họ tên</MudTh>
                            <MudTh>Phòng ban</MudTh>
                            <MudTh class="text-center">Đã đăng ký trong tháng</MudTh>
                            <MudTh class="text-center">Tổng ca làm (dự tính)</MudTh>
                            <MudTh class="text-center">Tổng giờ (dự tính)</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Chọn" Style="width:56px;">
                                <MudCheckBox T="bool"
                                             Value="@IsEmployeeSelected(context.EmployeeId)"
                                             ValueChanged="@(selected => ToggleEmployeeSelection(context.EmployeeId, selected))" />
                            </MudTd>
                            <MudTd DataLabel="Mã NV">@context.EmployeeId</MudTd>
                            <MudTd DataLabel="Họ tên">
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Class="px-0"
                                           OnClick="() => OpenEmployeeDetailAsync(context)">
                                    @context.FullName
                                </MudButton>
                            </MudTd>
                            <MudTd DataLabel="Phòng ban">@context.DepartmentName</MudTd>
                            <MudTd DataLabel="Đã đăng ký trong tháng" Class="text-center">@context.RegisteredShiftCount</MudTd>
                            <MudTd DataLabel="Tổng ca làm (dự tính)" Class="text-center">@context.EstimatedShiftCount.ToString("0.#")</MudTd>
                            <MudTd DataLabel="Tổng giờ (dự tính)" Class="text-center">@context.EstimatedWorkHours.ToString("0.#") giờ</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }
        </MudPaper>
    </MudStack>

    @if (selectedEmployee is not null)
    {
        <div class="admin-modal-overlay" @onclick="CloseModal">
            <div class="admin-modal" @onclick:stopPropagation="true">
                <p class="admin-modal-name">@selectedEmployee.FullName</p>
                <p class="admin-modal-sub">@GetModalSubtitle(selectedEmployee)</p>
                @if (isEmployeeDetailsLoading)
                {
                    <div class="admin-empty-card">Đang tải chi tiết ca...</div>
                }
                else if (!string.IsNullOrWhiteSpace(employeeDetailsErrorMessage))
                {
                    <div class="admin-alert-card">@employeeDetailsErrorMessage</div>
                }
                else if (selectedEmployeeDayDetails.Count == 0)
                {
                    <div class="admin-empty-card">Không có chi tiết ca trong tháng đã chọn.</div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th>Ngày</th>
                                <th>Mã ca</th>
                                <th>Tên ca</th>
                                <th>Giờ làm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in GetModalRows())
                            {
                                <tr>
                                    <td>@item.Date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</td>
                                    <td>@item.ShiftCode</td>
                                    <td>@item.ShiftName</td>
                                    <td>@FormatHours(item.WorkHours)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <div class="admin-modal-close">
                    <button type="button" @onclick="CloseModal">Đóng</button>
                </div>
            </div>
        </div>
    }
</RoleGuard>

@code {
    private readonly List<EmployeeShiftSummaryModel> _employeeSummaries = new();
    private readonly HashSet<string> _selectedEmployeeIds = new(StringComparer.OrdinalIgnoreCase);
    private List<EmployeeDetailShiftCodeInMonthModel> selectedEmployeeDayDetails = new();
    private Guid? lastLoadedDepartmentId;
    private string _searchText = string.Empty;
    private int _selectedMonth = DateTime.Today.Month;
    private int _selectedYear = DateTime.Today.Year;
    private bool _loading;
    private bool _refreshing;
    private bool _openingScheduleDialog;
    private bool _openingRegistrationDialog;
    private string? errorMessage;
    private EmployeeShiftSummaryModel? selectedEmployee;
    private bool isEmployeeDetailsLoading;
    private string? employeeDetailsErrorMessage;

    private DateOnly SelectedMonthDate => new(_selectedYear, _selectedMonth, 1);

    protected override async Task OnInitializedAsync()
    {
        RoleScopeService.Changed += OnRoleScopeChanged;
        PullToRefreshService.RefreshRequested += OnPullToRefreshRequestedAsync;
        await LoadAsync();
    }

    private async Task OnSelectedMonthChangedAsync(int value)
    {
        if (_selectedMonth == value)
        {
            return;
        }

        _selectedMonth = value;
        await LoadAsync();
    }

    private async Task OnSelectedYearChangedAsync(int value)
    {
        if (_selectedYear == value || value < 2020 || value > 2099)
        {
            return;
        }

        _selectedYear = value;
        await LoadAsync();
    }

    private async Task RefreshDataAsync()
    {
        if (_refreshing)
        {
            return;
        }

        _refreshing = true;
        try
        {
            await LoadAsync();
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task LoadAsync()
    {
        var scope = await RoleScopeService.LoadAsync();
        if (!scope.DepartmentId.HasValue)
        {
            _employeeSummaries.Clear();
            _selectedEmployeeIds.Clear();
            errorMessage = "Hãy chọn phòng ban để xem lịch ca.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        _loading = true;
        errorMessage = null;
        selectedEmployee = null;
        selectedEmployeeDayDetails.Clear();
        employeeDetailsErrorMessage = null;
        isEmployeeDetailsLoading = false;

        try
        {
            var summaries = await ShiftFeatureService.GetEmployeeSummariesAsync(scope.CompanyId, _selectedYear, _selectedMonth);

            _employeeSummaries.Clear();
            _employeeSummaries.AddRange(summaries
                .Where(item => item.DepartmentId == scope.DepartmentId)
                .OrderBy(item => item.FullName));

            lastLoadedDepartmentId = scope.DepartmentId;
            ReconcileSelectedEmployees();
        }
        catch (Exception ex)
        {
            _employeeSummaries.Clear();
            _selectedEmployeeIds.Clear();
            errorMessage = $"Không tải được dữ liệu ca làm phòng ban: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private List<EmployeeShiftSummaryModel> GetFilteredSummaries()
    {
        return _employeeSummaries
            .Where(item => string.IsNullOrWhiteSpace(_searchText)
                || item.EmployeeId.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || item.FullName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || item.DepartmentName.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(item => item.RegisteredShiftCount)
            .ThenBy(item => item.FullName)
            .ToList();
    }

    private string GetSelectedDepartmentLabel()
    {
        var departmentId = RoleScopeService.Current.DepartmentId;
        if (!departmentId.HasValue)
        {
            return "Chưa chọn";
        }

        return RoleScopeService.Current.Departments
            .FirstOrDefault(item => item.DepartmentId == departmentId.Value)
            ?.DepartmentName ?? "Phòng ban đã chọn";
    }

    private bool IsEmployeeSelected(string employeeId) => _selectedEmployeeIds.Contains(employeeId);

    private void ToggleEmployeeSelection(string employeeId, bool selected)
    {
        if (selected)
        {
            _selectedEmployeeIds.Add(employeeId);
        }
        else
        {
            _selectedEmployeeIds.Remove(employeeId);
        }
    }

    private void SelectAllFilteredEmployees()
    {
        foreach (var employee in GetFilteredSummaries())
        {
            _selectedEmployeeIds.Add(employee.EmployeeId);
        }
    }

    private void ClearSelectedEmployees()
    {
        _selectedEmployeeIds.Clear();
    }

    private async Task OnSummaryRowClickAsync(TableRowClickEventArgs<EmployeeShiftSummaryModel> args)
    {
        if (args.Item is not null)
        {
            await OpenEmployeeDetailAsync(args.Item);
        }
    }

    private async Task OpenEmployeeDetailAsync(EmployeeShiftSummaryModel employee)
    {
        selectedEmployee = employee;
        selectedEmployeeDayDetails.Clear();
        employeeDetailsErrorMessage = null;
        isEmployeeDetailsLoading = true;

        await InvokeAsync(StateHasChanged);

        try
        {
            var scope = await RoleScopeService.LoadAsync();
            selectedEmployeeDayDetails = await ShiftFeatureService.GetEmployeeDayDetailsAsync(
                scope.CompanyId,
                employee.EmployeeId,
                _selectedMonth,
                _selectedYear);
        }
        catch (Exception ex)
        {
            selectedEmployeeDayDetails.Clear();
            employeeDetailsErrorMessage = $"Không tải được chi tiết ca: {ex.Message}";
            Snackbar.Add(employeeDetailsErrorMessage, Severity.Error);
        }
        finally
        {
            isEmployeeDetailsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenRegistrationDialogAsync()
    {
        if (_openingRegistrationDialog)
        {
            return;
        }

        var scope = await RoleScopeService.LoadAsync();
        if (!scope.DepartmentId.HasValue)
        {
            Snackbar.Add("Hãy chọn phòng ban trước khi đăng ký ca.", Severity.Warning);
            return;
        }

        var employees = GetFilteredSummaries()
            .GroupBy(item => item.EmployeeId, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .OrderBy(item => item.FullName)
            .Select(item => new ManagerShiftEmployeeOption
            {
                EmployeeId = item.EmployeeId,
                FullName = item.FullName,
                DepartmentId = item.DepartmentId,
                DepartmentName = item.DepartmentName
            })
            .ToList();

        if (employees.Count == 0)
        {
            Snackbar.Add("Không có nhân viên để đăng ký ca trong phòng ban hiện tại.", Severity.Warning);
            return;
        }

        _openingRegistrationDialog = true;
        try
        {
            var selectedEmployeeIds = _selectedEmployeeIds.Count > 0
                ? employees.Where(item => _selectedEmployeeIds.Contains(item.EmployeeId)).Select(item => item.EmployeeId).ToList()
                : employees.Select(item => item.EmployeeId).ToList();

            var parameters = new DialogParameters
            {
                ["CompanyId"] = scope.CompanyId,
                ["DepartmentId"] = scope.DepartmentId,
                ["CreatedBy"] = scope.EmployeeId,
                ["Employees"] = employees,
                ["SelectedEmployeeIds"] = selectedEmployeeIds
            };

            var options = new DialogOptions
            {
                CloseOnEscapeKey = true,
                FullWidth = true,
                MaxWidth = MaxWidth.ExtraLarge
            };

            var dialog = await ShiftDialogService.ShowAsync<ManagerShiftRegistrationDialog>("Đăng ký ca", parameters, options);
            if (dialog is null)
            {
                return;
            }

            var result = await dialog.Result;
            if (result?.Canceled == false)
            {
                await LoadAsync();
            }
        }
        finally
        {
            _openingRegistrationDialog = false;
        }
    }

    private async Task OpenWeeklyScheduleDialogAsync()
    {
        if (_openingScheduleDialog)
        {
            return;
        }

        var scope = await RoleScopeService.LoadAsync();
        if (!scope.DepartmentId.HasValue)
        {
            Snackbar.Add("Hãy chọn phòng ban trước khi xem bảng lịch ca.", Severity.Warning);
            return;
        }

        _openingScheduleDialog = true;
        try
        {
            var weekStartDate = GetWeekStartDate(SelectedMonthDate);
            var rows = await ShiftFeatureService.GetWeeklyScheduleAsync(scope.CompanyId, scope.DepartmentId.Value, weekStartDate);

            var parameters = new DialogParameters
            {
                ["Rows"] = rows,
                ["DepartmentName"] = GetSelectedDepartmentLabel(),
                ["WeekStartDate"] = weekStartDate
            };

            var options = new DialogOptions
            {
                CloseOnEscapeKey = true,
                FullWidth = true,
                MaxWidth = MaxWidth.ExtraLarge
            };

            await ShiftDialogService.ShowAsync<ManagerWeeklyScheduleDialog>("Bảng lịch ca", parameters, options);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không tải được bảng lịch ca: {ex.Message}", Severity.Error);
        }
        finally
        {
            _openingScheduleDialog = false;
        }
    }

    private void CloseModal()
    {
        selectedEmployee = null;
        selectedEmployeeDayDetails.Clear();
        employeeDetailsErrorMessage = null;
        isEmployeeDetailsLoading = false;
    }

    private void OnRoleScopeChanged()
    {
        if (RoleScopeService.Current.DepartmentId != lastLoadedDepartmentId)
        {
            _ = InvokeAsync(LoadAsync);
        }
        else
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        RoleScopeService.Changed -= OnRoleScopeChanged;
        PullToRefreshService.RefreshRequested -= OnPullToRefreshRequestedAsync;
    }

    private async Task OnPullToRefreshRequestedAsync()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!currentPath.StartsWith("manager/shift", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await InvokeAsync(RefreshDataAsync);
    }

    private IEnumerable<EmployeeDetailShiftCodeInMonthModel> GetModalRows()
    {
        return selectedEmployeeDayDetails
            .Where(item => item.Date.Year == _selectedYear && item.Date.Month == _selectedMonth)
            .OrderBy(item => item.Date);
    }

    private string GetModalSubtitle(EmployeeShiftSummaryModel employee)
    {
        return $"{employee.DepartmentName} · {_selectedMonth}/{_selectedYear} · {employee.RegisteredShiftCount} ca đã đăng ký";
    }

    private void ReconcileSelectedEmployees()
    {
        var validIds = _employeeSummaries.Select(item => item.EmployeeId).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _selectedEmployeeIds.RemoveWhere(id => !validIds.Contains(id));
    }

    private static DateOnly GetWeekStartDate(DateOnly date)
    {
        var offset = ((int)date.DayOfWeek + 6) % 7;
        return date.AddDays(-offset);
    }

    private static string FormatHours(decimal workHours)
    {
        return workHours <= 0 ? "-" : $"{workHours.ToString("0.##", CultureInfo.InvariantCulture)} giờ";
    }
}