@page "/manager/shift/register"
@implements IDisposable
@using System.Globalization
@using ERP_PAYROLLMOBILE.Models.ManagerRole.ManagerShift
@using ERP_PAYROLLMOBILE.Services.Features.Shift
@using ERP_PAYROLLMOBILE.Services.RoleScope
@inject IShiftFeatureService ShiftFeatureService
@inject IRoleScopeService RoleScopeService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Đăng ký ca</PageTitle>

<RoleGuard AllowedRole="@ERP_PAYROLLMOBILE.Services.RoleScope.AppRole.Manager">
    <div class="manager-shift-page">
        <div class="admin-wrap">
            <div class="content">
            <div class="admin-card">
                <div class="shift-screen-tabs" role="tablist" aria-label="Điều hướng đăng ký ca">
                    <button class="shift-screen-tab" type="button" @onclick="OpenRequestPage">
                        <span class="tab-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12h6" /><path d="M12 9v6" /><path d="M9 3h6l2 2h4v16H3V5h4z" /></svg>
                        </span>
                        <span>Yêu cầu đăng ký ca</span>
                    </button>
                    <button class="shift-screen-tab" type="button" @onclick="OpenSchedulePage">
                        <span class="tab-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                        </span>
                        <span>Bảng lịch ca</span>
                    </button>
                    <button class="shift-screen-tab is-active" type="button" aria-current="page">
                        <span class="tab-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" /></svg>
                        </span>
                        <span>Đăng ký ca</span>
                    </button>
                </div>
            </div>

            <div class="admin-card">
                <div class="register-header">
                    <div>
                        <p class="register-title">Đăng ký ca</p>
                        <p class="register-subtitle">Nhập danh sách nhân viên và thông tin ca để tạo đăng ký tuần hoặc tháng.</p>
                    </div>
                </div>

                <div class="register-toolbar">
                    <div class="filter-field register-filter-field">
                        <label for="register-month-filter">Tháng dữ liệu</label>
                        <select id="register-month-filter" value="@selectedMonth.Month" @onchange="OnMonthChangedAsync">
                            @for (var month = 1; month <= 12; month++)
                            {
                                <option value="@month">Tháng @month</option>
                            }
                        </select>
                    </div>
                    <div class="filter-field register-filter-field">
                        <label for="register-year-filter">Năm dữ liệu</label>
                        <select id="register-year-filter" value="@selectedMonth.Year" @onchange="OnYearChangedAsync">
                            @for (var year = DateTime.Today.Year - 1; year <= DateTime.Today.Year + 2; year++)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                </div>

                @if (isLoading)
                {
                    <div class="register-empty">Đang tải danh sách nhân viên...</div>
                }
                else if (!string.IsNullOrWhiteSpace(bodyMessage))
                {
                    <div class="register-empty">@bodyMessage</div>
                }
                else
                {
                    <div class="register-summary-card">
                        <div>
                            <p class="register-summary-title">@employees.Count nhân viên sẵn sàng đăng ký ca</p>
                            <p class="register-summary-text">Dữ liệu nhân viên được lấy từ phòng ban đang chọn trong kỳ @selectedMonth.ToString("MM/yyyy", CultureInfo.InvariantCulture).</p>
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenRegistrationDialogAsync">
                            Mở đăng ký ca
                        </MudButton>
                    </div>
                }
            </div>
            </div>
        </div>

    </div>
</RoleGuard>

@code {
    private readonly List<ManagerShiftEmployeeOption> employees = new();
    private DateOnly selectedMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private Guid? lastLoadedDepartmentId;
    private string? bodyMessage;
    private bool isLoading;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        RoleScopeService.Changed += OnRoleScopeChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var scope = await RoleScopeService.LoadAsync();
        if (!scope.DepartmentId.HasValue)
        {
            employees.Clear();
            bodyMessage = "Hãy chọn phòng ban để đăng ký ca.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        isLoading = true;
        bodyMessage = null;
        try
        {
            var summaries = await ShiftFeatureService.GetEmployeeSummariesAsync(scope.CompanyId, selectedMonth.Year, selectedMonth.Month);

            employees.Clear();
            employees.AddRange(summaries
                .Where(item => item.DepartmentId == scope.DepartmentId)
                .GroupBy(item => item.EmployeeId, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderBy(item => item.FullName)
                .Select(item => new ManagerShiftEmployeeOption
                {
                    EmployeeId = item.EmployeeId,
                    FullName = item.FullName,
                    DepartmentId = item.DepartmentId,
                    DepartmentName = item.DepartmentName
                }));

            lastLoadedDepartmentId = scope.DepartmentId;
            if (employees.Count == 0)
            {
                bodyMessage = "Không có nhân viên để đăng ký ca trong kỳ đã chọn.";
            }
        }
        catch (Exception ex)
        {
            employees.Clear();
            bodyMessage = "Không tải được danh sách nhân viên đăng ký ca.";
            Snackbar.Add($"Không tải được danh sách nhân viên đăng ký ca: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenRegistrationDialogAsync()
    {
        var scope = await RoleScopeService.LoadAsync();
        if (!scope.DepartmentId.HasValue)
        {
            Snackbar.Add("Hãy chọn phòng ban trước khi đăng ký ca.", Severity.Warning);
            return;
        }

        if (employees.Count == 0)
        {
            Snackbar.Add("Không có nhân viên để đăng ký ca trong phòng ban hiện tại.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["CompanyId"] = scope.CompanyId,
            ["DepartmentId"] = scope.DepartmentId,
            ["CreatedBy"] = scope.EmployeeId,
            ["Employees"] = employees.ToList(),
            ["SelectedEmployeeIds"] = employees.Select(item => item.EmployeeId).ToList()
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        var dialog = await DialogService.ShowAsync<ManagerShiftRegistrationDialog>("Đăng ký ca", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OnMonthChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var month))
        {
            selectedMonth = new DateOnly(selectedMonth.Year, month, 1);
            await LoadAsync();
        }
    }

    private async Task OnYearChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var year))
        {
            selectedMonth = new DateOnly(year, selectedMonth.Month, 1);
            await LoadAsync();
        }
    }

    private void OnRoleScopeChanged()
    {
        if (RoleScopeService.Current.DepartmentId != lastLoadedDepartmentId)
        {
            _ = InvokeAsync(LoadAsync);
        }
    }

    public void Dispose()
    {
        RoleScopeService.Changed -= OnRoleScopeChanged;
    }

    private void OpenRequestPage()
    {
        Navigation.NavigateTo("/manager/shift/registrations");
    }

    private void OpenSchedulePage()
    {
        Navigation.NavigateTo("/manager/shift");
    }
}
