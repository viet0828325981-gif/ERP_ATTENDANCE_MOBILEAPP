@page "/"
@using ERP_PAYROLLMOBILE.Services.RoleScope
@inject IRoleScopeService RoleScopeService
@inject NavigationManager Navigation

<PageTitle>Điều hướng</PageTitle>

<div class="home-redirect-state">Đang chuyển trang...</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var scope = await RoleScopeService.LoadAsync();
        var target = scope.Role switch
        {
            ERP_PAYROLLMOBILE.Services.RoleScope.AppRole.Manager => "/manager/daily",
            ERP_PAYROLLMOBILE.Services.RoleScope.AppRole.Admin => "/manager/daily",
            _ => "/employee/daily"
        };

        Navigation.NavigateTo(target, replace: true);
    }
}
