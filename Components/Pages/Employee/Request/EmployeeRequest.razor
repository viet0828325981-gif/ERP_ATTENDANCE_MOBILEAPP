    private void ValidateOnlineForm()
    {
        if (selectedOnlineDates.Count == 0)
        {
            throw new Exception("Vui lòng chọn ít nhất một ngày online.");
        }

        if (string.IsNullOrWhiteSpace(formShiftCode))
        {
            throw new Exception("Vui lòng chọn ca online.");
        }
    }

    private async Task CancelRequestAsync(WorkRequestModel request)
    {
        if (request.Status != 0)
        {
            return;
        }

        isCancelling = true;
        cancellingRequestId = request.Id;

        try
        {
            string message;
            if (request.IsGroupedOnline)
            {
                var cancelGroupRequest = await RequestBuilder.BuildCancelOnlineGroupRequestAsync(request.RequestType, request.CreatedAt);
                message = await EmployeeRequestApiClient.CancelOnlineGroupAsync(companyId, cancelGroupRequest);
            }
            else
            {
                var cancelRequest = await RequestBuilder.BuildCancelRequestAsync(companyId, request.Id);
                message = await EmployeeRequestApiClient.CancelAsync(cancelRequest);
            }

            Snackbar.Add(string.IsNullOrWhiteSpace(message) ? "Đã hủy yêu cầu thành công." : message, Severity.Success);
            await LoadRequestsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không hủy được yêu cầu: {ex.Message}", Severity.Error);
        }
        finally
        {
            isCancelling = false;
            cancellingRequestId = null;
        }
    }

