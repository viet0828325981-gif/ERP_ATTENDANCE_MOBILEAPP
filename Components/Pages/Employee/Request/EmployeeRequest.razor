    private IReadOnlyList<DimCalendarModel> GetSingleDateOptions(string requestType)
    {
        return requestType switch
        {
            "WORK_HOLIDAY" => CalendarDays.Where(item => item.PaidLeaveDays > 0).OrderBy(item => item.WorkDate).ToList(),
            "WORK_WEEKEND" => CalendarDays.Where(IsWeekend).OrderBy(item => item.WorkDate).ToList(),
            _ => CalendarDays.OrderBy(item => item.WorkDate).ToList()
        };
    }

    private IReadOnlyList<DimCalendarModel> GetOnlineDateOptions(string requestType)
    {
        return requestType switch
        {
            "WORK_ONLINE_HOLIDAY" => CalendarDays.Where(item => item.PaidLeaveDays > 0).OrderBy(item => item.WorkDate).ToList(),
            "WORK_ONLINE_WEEKEND" => CalendarDays.Where(IsWeekend).OrderBy(item => item.WorkDate).ToList(),
            _ => CalendarDays.Where(item => !IsWeekend(item) && item.PaidLeaveDays <= 0).OrderBy(item => item.WorkDate).ToList()
        };
    }

    private static bool IsWeekend(DimCalendarModel item)
    {
        return item.DayOfWeek is 6 or 7;
    }

    private void ToggleOnlineDate(DateOnly workDate)
    {
        if (!selectedOnlineDates.Add(workDate))
        {
            selectedOnlineDates.Remove(workDate);
        }
    }

    private Task OnTargetDateChanged(ChangeEventArgs args)
    {
        formTargetDate = ParseDate(args.Value?.ToString(), formTargetDate);
        return Task.CompletedTask;
    }

    private Task OnSourceDateChanged(ChangeEventArgs args)
    {
        formSourceDate = ParseDate(args.Value?.ToString(), formSourceDate);
        return Task.CompletedTask;
    }

    private Task OnMinutesChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value))
        {
            formMinutesAffected = value;
        }

        return Task.CompletedTask;
    }

    private Task OnShiftCodeChanged(ChangeEventArgs args)
    {
        formShiftCode = args.Value?.ToString() ?? string.Empty;
        return Task.CompletedTask;
    }

    private string GetCreateRequestTitle()
    {
        return string.IsNullOrWhiteSpace(createRequestType)
            ? "Chọn loại yêu cầu để nhập thông tin"
            : RequestBuilder.GetRequestTypeDisplayName(createRequestType, createRequestType);
    }

    private string GetRequestTypeLabel(string requestType)
    {
        return RequestBuilder.GetRequestTypeDisplayName(requestType, requestType);
    }

    private static string ToDateInput(DateOnly value)
    {
        return value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private static DateOnly ParseDate(string? value, DateOnly fallback)
    {
        return DateOnly.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
            ? parsed
            : fallback;
    }

    private async Task RefreshDataAsync()
    {
        if (isLoading || isSubmittingCreateRequest || isCancelling || isGroupLoading)
        {
            return;
        }

        await ReloadAllAsync();
    }

    private async Task OnPullToRefreshRequestedAsync()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!currentPath.StartsWith("yeu-cau", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await InvokeAsync(RefreshDataAsync);
    }

    public void Dispose()
    {
        PullToRefreshService.RefreshRequested -= OnPullToRefreshRequestedAsync;
    }
}
